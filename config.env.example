# Environment-specific settings for docking-regression.
#
#   cp config.env.example config.env     # then edit if your paths differ
#
# config.env is gitignored; this .example is the committed template. Every
# slurm/*.sh sources config.env (if present) after resolving the repo root.
# Anything left unset falls back to the defaults below, so nothing breaks if
# config.env does not exist.

# Conda
CONDA_SH=/N/slate/mengjing/miniconda3/etc/profile.d/conda.sh
CONDA_ENV=py310

# Where derived artifacts live (score arrays, splits, caches, runs).
# dockreg.pools reads this; keep it off the repo's git history.
DOCKREG_WORK=/N/slate/mengjing/repos/docking-regression/work

# Slurm account used by every submit script here.
DR_ACCOUNT=r00939
